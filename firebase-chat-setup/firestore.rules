rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'sonusharmax301@gmail.com';
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /conversations/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.messageLimit == 30;
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && ((('paidPlan' in resource.data) && request.resource.data.messageLimit == resource.data.messageLimit)
            || (!('paidPlan' in resource.data) && request.resource.data.messageLimit == 30))
          && request.resource.data.name == resource.data.name)
        || isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && ((request.auth.uid == uid && request.resource.data.sender == 'user')
            || (isAdmin() && request.resource.data.sender == 'admin'));
        allow update, delete: if isAdmin();
      }
    }

    match /paymentRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 60
        && request.resource.data.amount in [199, 499]
        && request.resource.data.utr is string
        && request.resource.data.utr.size() >= 6
        && request.resource.data.utr.size() <= 80
        && request.resource.data.status == 'pending'
        && request.resource.data.plan in ['messages150', 'unlimited']
        && ((request.resource.data.plan == 'messages150' && request.resource.data.amount == 199 && request.resource.data.messagesToAdd == 150 && request.resource.data.unlimited == false)
          || (request.resource.data.plan == 'unlimited' && request.resource.data.amount == 499 && request.resource.data.messagesToAdd == 0 && request.resource.data.unlimited == true));
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isAdmin();
    }
  }
}
