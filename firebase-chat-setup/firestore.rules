rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /conversations/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string;
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin())
        && request.resource.data.uid == uid;
      allow delete: if isAdmin();
      match /messages/{messageId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && ((request.auth.uid == uid && request.resource.data.sender == 'user')
            || (isAdmin() && request.resource.data.sender == 'admin'));
        allow update, delete: if isAdmin();
      }
    }
  }
}
