rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'sonusharmax301@gmail.com';
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /presence/{presenceId} {
      allow read: if signedIn() && presenceId == 'admin';
      allow create, update: if isAdmin()
        && presenceId == 'admin'
        && request.resource.data.status in ['online', 'offline'];
      allow delete: if false;
    }

    match /conversations/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.messageLimit == 30;

      allow get: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.name == resource.data.name
        && (
          ('paidPlan' in resource.data
            && request.resource.data.messageLimit == resource.data.messageLimit)
          ||
          (!('paidPlan' in resource.data)
            && request.resource.data.messageLimit == 30)
        )
      );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn()
          && (request.auth.uid == uid || isAdmin());

        allow create: if signedIn()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && (
            (request.auth.uid == uid
              && request.resource.data.sender == 'user')
            ||
            (isAdmin()
              && request.resource.data.sender == 'admin')
          );

        allow update: if isAdmin()
          || (signedIn() && request.auth.uid == uid
            && resource.data.sender == 'admin'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByUser', 'seenByUserAt'])
            && request.resource.data.seenByUser == true)
          || (isAdmin()
            && resource.data.sender == 'user'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByAdmin', 'seenByAdminAt'])
            && request.resource.data.seenByAdmin == true);
        allow delete: if isAdmin();
      }
    }

    match /paymentRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 60
        && request.resource.data.status == 'pending'
        && request.resource.data.utr is string
        && request.resource.data.utr.matches('^[0-9]{12}$')
        && (
          (
            request.resource.data.plan == 'messages150'
            && request.resource.data.amount == 199
            && request.resource.data.messagesToAdd == 150
            && request.resource.data.unlimited == false
          )
          ||
          (
            request.resource.data.plan == 'unlimited'
            && request.resource.data.amount == 499
            && request.resource.data.messagesToAdd == 0
            && request.resource.data.unlimited == true
          )
          ||
          (
            request.resource.data.plan == 'storyPack1'
            && request.resource.data.packId == '1'
            && request.resource.data.amount == 299
            && request.resource.data.packName == '5 Private Photos'
          )
          ||
          (
            request.resource.data.plan == 'storyPack2'
            && request.resource.data.packId == '2'
            && request.resource.data.amount == 599
            && request.resource.data.packName == '10 Night Photos'
          )
          ||
          (
            request.resource.data.plan == 'storyPack3'
            && request.resource.data.packId == '3'
            && request.resource.data.amount == 899
            && request.resource.data.packName == '3 Hot Videos'
          )
          ||
          (
            request.resource.data.plan == 'storyPack4'
            && request.resource.data.packId == '4'
            && request.resource.data.amount == 5999
            && request.resource.data.packName == 'WhatsApp Number'
          )
          ||
          (
            request.resource.data.plan == 'storyPack5'
            && request.resource.data.packId == '5'
            && request.resource.data.amount == 1999
            && request.resource.data.packName == 'Snapchat ID'
          )
        );

      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.status in ['approved', 'rejected'];

      allow delete: if isAdmin();
    }

    match /packAccess/{accessId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create, update: if isAdmin()
        && request.resource.data.uid is string
        && request.resource.data.packId in ['1', '2', '3', '4', '5']
        && request.resource.data.status == 'approved';

      allow delete: if isAdmin();
    }
  }
}
